{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8020", "--bind", "127.0.0.1"],
      "port": 8020
    },
    {
      "name": "wp-local",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "127.0.0.1:8031", "-t", ".wp-local/wordpress", ".wp-local/router.php"],
      "port": 8031
    },
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": ["laravel/artisan", "serve", "--host", "127.0.0.1", "--port", "8040"],
      "port": 8040
    },
    {
      "name": "laravel-bundle",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd .deploy/laravel-test/laravel-20sotok/public && exec php -S 127.0.0.1:8050 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"],
      "port": 8050
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
